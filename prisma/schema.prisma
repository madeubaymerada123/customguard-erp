generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HsCode {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(12)
  description String?
  bmRate      Decimal @map("bm_rate") @db.Decimal(5, 2)
  ppnRate     Decimal @map("ppn_rate") @db.Decimal(5, 2)
  pph22Rate   Decimal @map("pph22_rate") @db.Decimal(5, 2)
  items       Item[]

  @@map("hs_codes")
}

model Item {
  id       Int      @id @default(autoincrement())
  sku      String   @unique @db.VarChar(50)
  name     String
  itemType ItemType @map("item_type")
  uom      String   @db.VarChar(10)
  hsCodeId Int?     @map("hs_code_id")
  hsCode   HsCode?  @relation(fields: [hsCodeId], references: [id])

  bomAsFg  BomLine[] @relation("BomFg")
  bomAsRaw BomLine[] @relation("BomRaw")

  batches   ProductionBatch[]
  movements StockMovement[]

  @@map("items")
}

model BomLine {
  id         Int     @id @default(autoincrement())
  fgItemId   Int     @map("fg_item_id")
  rawItemId  Int     @map("raw_item_id")
  qtyPerUnit Decimal @map("qty_per_unit") @db.Decimal(12, 4)
  scrapPct   Decimal @default(0) @map("scrap_pct") @db.Decimal(5, 2)
  fgItem     Item    @relation("BomFg", fields: [fgItemId], references: [id])
  rawItem    Item    @relation("BomRaw", fields: [rawItemId], references: [id])

  @@unique([fgItemId, rawItemId])
  @@map("bom_lines")
}

model CustomsDocument {
  id        Int      @id @default(autoincrement())
  docType   String   @map("doc_type") @db.VarChar(10)
  docNumber String   @unique @map("doc_number") @db.VarChar(50)
  docDate   DateTime @map("doc_date") @db.Date

  movements StockMovement[]

  @@map("customs_documents")
}

model ProductionBatch {
  id          Int      @id @default(autoincrement())
  fgItemId    Int      @map("fg_item_id")
  qtyProduced Decimal  @map("qty_produced") @db.Decimal(12, 2)
  producedAt  DateTime @default(now()) @map("produced_at")
  fgItem      Item     @relation(fields: [fgItemId], references: [id])

  movements StockMovement[]

  @@map("production_batches")
}

model StockMovement {
  id           BigInt       @id @default(autoincrement())
  itemId       Int          @map("item_id")
  movementType MovementType @map("movement_type")
  qty          Decimal      @db.Decimal(14, 4)
  customsDocId Int?         @map("customs_doc_id")
  batchId      Int?         @map("batch_id")
  taxStatus    TaxStatus?   @map("tax_status")
  movedAt      DateTime     @default(now()) @map("moved_at")

  item       Item             @relation(fields: [itemId], references: [id])
  customsDoc CustomsDocument? @relation(fields: [customsDocId], references: [id])
  batch      ProductionBatch? @relation(fields: [batchId], references: [id])

  @@index([itemId, movedAt])
  @@map("stock_movements")
}

enum ItemType {
  RAW
  FG
  SCRAP
}

enum MovementType {
  INBOUND
  PROD_CONSUME
  PROD_OUTPUT
  SCRAP
  OUTBOUND_EXPORT
  OUTBOUND_LOCAL
}

enum TaxStatus {
  DITANGGUHKAN
  DIBEBASKAN
  DIBAYAR
}
